# Copy to backend/.env and fill in real values. backend/.env is gitignored and never committed.
# Used by docker-compose (env_file) and backend dotenv loader.

# Postgres (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=igem_education

# Backend
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=igem_education

# Auth -- use a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=you@example.com

# LibreTranslate
LT_URL=http://127.0.0.1:5000

# Service
API_URL=http://127.0.0.1:3000
PORT=3000

# 安全: 默认关闭, 不要打开。
# 设为 true 会挂载 /api/auth/debug-code/:email —— 该接口没有任何鉴权, 会直接
# 返回某邮箱待用的注册/密码重置验证码, 配合 /api/auth/send-password-reset-code
# 可接管任意账号。仅供本机调试或 frontend/tests/smoke.mjs 使用, 切勿用于公网。
ENABLE_AUTH_DEBUG_ROUTES=false