# Copy to backend/.env and fill in real values. backend/.env is gitignored and never committed.
# Used by docker-compose (env_file) and backend dotenv loader.

# Postgres (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=igem_education

# Backend
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=igem_education

# Auth -- use a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=you@example.com

# LibreTranslate
LT_URL=http://127.0.0.1:5000

# Service
API_URL=http://127.0.0.1:3000
PORT=3000